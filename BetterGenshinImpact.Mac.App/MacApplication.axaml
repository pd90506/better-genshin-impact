<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
             x:Class="BetterGenshinImpact.MacApp.MacApplication"
             Name="BetterGI"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" />
                    <SolidColorBrush x:Key="CardBackground" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#51000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="CardBackground" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#3FFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
            <Color x:Key="AccentFillColorDefault">#4CC2FF</Color>
            <Color x:Key="SystemAccentColorPrimary">#4CC2FF</Color>
            <Color x:Key="SystemAccentColorSecondary">#99EBFF</Color>
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
            <FontFamily x:Key="TextThemeFontFamily">PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Inter</FontFamily>

            <!-- 原版 App.xaml 中注册的转换器 -->
            <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <c:BooleanToVisibilityRevertConverter x:Key="BooleanToVisibilityRevertConverter" />
            <c:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <c:NotNullConverter x:Key="NotNullConverter" />
            <c:BooleanToEnableTextConverter x:Key="BooleanToEnableTextConverter" />
            <c:EnumToKVPConverter x:Key="EnumToKVPConverter" />
            <c:CultureInfoNameToKVPConverter x:Key="CultureInfoNameToKVPConverter" />
            <c:StringToColorConverter x:Key="StringToColorConverter" />
            <c:AdaptiveUniformGridColumnsConverter x:Key="AdaptiveUniformGridColumnsConverter" />
            <c:DomainNameConverter x:Key="DomainNameConverter" />
            <c:AutoBossNameConverter x:Key="AutoBossNameConverter" />
            <c:MillisecondsToTimeConverter x:Key="MillisecondsToTimeConverter" />
            <c:ImageSourceToBitmapConverter x:Key="ImageSourceToBitmapConverter" />
            <c:WpfBrushConverter x:Key="WpfBrushConverter" />

            <!-- 设置卡片：左侧标题，右侧控件 -->
            <ControlTheme x:Key="{x:Type c:CardControl}" TargetType="c:CardControl">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource TextThemeFontFamily}" />
        </Style>

        <!-- 原版 CardExpander：带卡片背景的折叠面板 -->
        <Style Selector="Expander.card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Expander.card /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Application.Styles>

</Application>
