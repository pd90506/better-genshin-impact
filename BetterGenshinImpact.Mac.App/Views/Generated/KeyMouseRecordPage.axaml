<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.KeyMouseRecordPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
                FontWeight="SemiBold"
                Grid.Row="0"
                Margin="0,0,0,8"
                Text="{i18n:T 键鼠录制回放功能（实验功能）}" />
        <TextBlock
                Grid.Row="1"
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap">
            <Run Text="{i18n:T 建议在游戏内使用快捷键进行录制，录制完成后在调度器中使用。}" />
            <Span Command="{Binding GoToKmScriptUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{i18n:T 点击查看键鼠录制回放功能教程}" />
            </Span>
        </TextBlock>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Command="{Binding OpenScriptFolderCommand}" Content="{i18n:T 打开脚本目录}" />
            <Separator Width="10" Opacity="0" />
            <Button Command="{Binding OpenLocalScriptRepoCommand}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="{i18n:T 脚本仓库}" />
                </Grid>
            </Button>
            <Separator Width="10" Opacity="0" />
            <Button Command="{Binding StartRecordCommand}" Content="{i18n:T 开始录制}" IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
            <Separator Width="10" Opacity="0" />
            <Button Command="{Binding StopRecordCommand}" Content="{i18n:T 停止录制}" IsEnabled="{Binding IsRecording}" />
        </StackPanel>
        <Separator Grid.Row="3" Height="10" Opacity="0" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Col1" Grid.Column="0" />
            <Grid x:Name="Col2" Grid.Column="1" />
            <Grid x:Name="Col3" Grid.Column="2" />
        </Grid>
        <DockPanel Grid.Row="5">
            <Grid ColumnDefinitions="*,*,*" Margin="12,4" DockPanel.Dock="Top">
                <TextBlock Text="{i18n:T 名称}" Grid.Column="0" Classes="caption" />
                <TextBlock Text="{i18n:T 创建时间}" Grid.Column="1" Classes="caption" />
                <TextBlock Text="{i18n:T 操作}" Grid.Column="2" Classes="caption" />
            </Grid>
            <ListBox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ItemsSource="{Binding ScriptItems}"
                    SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*,*">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Grid.Column="0" />
                            <TextBlock Text="{Binding CreateTimeStr}" VerticalAlignment="Center" Grid.Column="1" />
                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                <Button Command="{Binding #PageRoot.DataContext.StartPlayCommand}" CommandParameter="{Binding Path}" Content="{i18n:T 播放脚本}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding EditScriptCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.SelectedItem}" Header="{i18n:T 修改名称}" />
                        <MenuItem Command="{Binding DeleteScriptCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.SelectedItem}" Header="{i18n:T 删除}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
