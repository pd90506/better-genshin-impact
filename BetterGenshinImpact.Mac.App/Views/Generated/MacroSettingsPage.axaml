<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.MacroSettingsPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="{StaticResource PagePadding}">
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{i18n:T 辅助操控设置}" />
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一键宏（按角色）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 触发后会识别当前出战角色，并根据配置执行对应的宏}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.MacroConfig.CombatMacroEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 快捷键触发方式}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 按住时重复：按住时重复执行；触发：按下启动再按关闭}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding QuickFightMacroHotkeyMode}"
                            SelectedItem="{Binding Config.MacroConfig.CombatMacroHotkeyMode, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 宏配置}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 配置每个角色执行的宏，比如：胡桃A重跳，}" />
                        <Span Command="{Binding GoToOneKeyMacroUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 点击查看说明}" />
                        </Span>
                    </TextBlock>
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding EditAvatarMacroCommand}"
                            Content="{i18n:T 前往设置}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 默认战斗宏编号}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 当角色的 macroPriority 设置为0时，使用此默认宏编号（1~5）}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.MacroConfig.CombatMacroPriority, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="{i18n:T 角色个性化宏编号设置}" TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 上方宏配置支持为每个角色单独设置宏编号。在角色宏配置中设置 macroPriority 字段（1-5），设置为0则使用上面的默认战斗宏编号。}"
                            TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一键领取奖励}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 识别当前页面的领取按钮或礼物图标并点击，需要配置快捷键进行触发}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            Command="{Binding GoToHotKeyPageCommand}"
                            Content="{i18n:T 绑定快捷键}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 模式选择}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 点按一次会领取当前页面可见图标；按住持续会在松开快捷键时立即停止}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding OneKeyClaimRewardHotkeyMode}"
                            SelectedItem="{Binding Config.MacroConfig.OneKeyClaimRewardHotkeyMode, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 未找到领取图标时滚轮下滑}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 仅在按住持续模式下可用}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.MacroConfig.OneKeyClaimRewardScrollDownEnabled, Mode=TwoWay}"
                            IsEnabled="{Binding OneKeyClaimRewardScrollOptionEnabled}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 滚轮下滑幅度}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 数值越大，每次未找到领取图标时向下滚动越多}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="180"
                            Margin="0,0,36,0"
                            Maximum="1000"
                            Minimum="1"
                            Value="{Binding Config.MacroConfig.OneKeyClaimRewardScrollDownAmount, Mode=TwoWay}"
                            IsEnabled="{Binding OneKeyClaimRewardScrollAmountOptionEnabled}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 那维莱特 - 转圈圈}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 快速水平平移鼠标，需要配置快捷键进行触发}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            Command="{Binding GoToHotKeyPageCommand}"
                            Content="{i18n:T 绑定快捷键}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 移动鼠标距离}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 可以为负数，绝对值越大移动越快，请不要配置太大}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.MacroConfig.RunaroundMouseXInterval, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 移动鼠标间隔（毫秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 尽量设置大于0的数字，配置完毕后请切换页签生效（其他配置也一样）}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.MacroConfig.RunaroundInterval, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 快速强化圣遗物}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 快速跳过强化结果展示，需要配置快捷键进行触发}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            Command="{Binding GoToHotKeyPageCommand}"
                            Content="{i18n:T 绑定快捷键}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 强化的额外等待时间（毫秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 高延迟下无法跳过强化结果显示时，需要延长这个时间配置}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="1000"
                            Minimum="0"
                            Value="{Binding Config.MacroConfig.EnhanceWaitDelay, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <c:CardControl Margin="0,0,0,12">
            <c:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一键购买}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在物品购买/兑换页使用，从选中物品处开始，长按持续购买}"
                            TextWrapping="Wrap" />
                </Grid>
            </c:CardControl.Header>
            <Button Margin="0,0,36,0" Command="{Binding GoToHotKeyPageCommand}" Content="{i18n:T 绑定快捷键}" />
        </c:CardControl>
        <c:CardControl Margin="0,0,0,12">
            <c:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一键进出尘歌壶}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 一键自动打开背包，放置尘歌壶并进入}"
                            TextWrapping="Wrap" />
                </Grid>
            </c:CardControl.Header>
            <Button Margin="0,0,36,0" Command="{Binding GoToHotKeyPageCommand}" Content="{i18n:T 绑定快捷键}" />
        </c:CardControl>
        <c:CardControl Margin="0,0,0,12">
            <c:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一键确认/取消}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 绑定快捷键到原神的确认/取消按钮}"
                            TextWrapping="Wrap" />
                </Grid>
            </c:CardControl.Header>
            <Button Margin="0,0,36,0" Command="{Binding GoToHotKeyPageCommand}" Content="{i18n:T 绑定快捷键}" />
        </c:CardControl>
        <c:CardControl Margin="0,0,0,12">
            <c:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 长按空格等于连续按下空格}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 轻松解除冻结，由于在水下存在长按的空格的场景，所以不推荐启用}"
                            TextWrapping="Wrap" />
                </Grid>
            </c:CardControl.Header>
            <ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding Config.MacroConfig.SpacePressHoldToContinuationEnabled, Mode=TwoWay}" />
        </c:CardControl>
        <c:CardControl Margin="0,0,0,12">
            <c:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 长按 F 等于连续按下 F }"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 快速拾取大量掉落物，有自动拾取的功能下，就显得比较鸡肋了}"
                            TextWrapping="Wrap" />
                </Grid>
            </c:CardControl.Header>
            <ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding Config.MacroConfig.FPressHoldToContinuationEnabled, Mode=TwoWay}" />
        </c:CardControl>
    </StackPanel>
</UserControl>
