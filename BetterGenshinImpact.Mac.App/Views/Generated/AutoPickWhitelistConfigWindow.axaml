<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.AutoPickWhitelistConfigWindow"
        x:Name="PageRoot"
        Width="500"
        Height="640"
        MinWidth="400"
        MinHeight="400"
        FontFamily="{DynamicResource TextThemeFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="*" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
                Grid.Row="1"
                Margin="20,12,20,12"
                Padding="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{i18n:T 仅拾取最终列表中的内容}" />
                <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{i18n:T 最终拾取列表为（默认拾取列表 ∪ 用户拾取列表）− 用户不拾取列表。聊天/设置图标及安全排除规则仍然优先。}"
                        TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="2" Margin="20,0,20,0">
            <TabItem Header="{i18n:T 拾取（基础列表）}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{i18n:T 白名单模式启用期间，默认拾取列表和用户拾取列表始终生效。}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AcceptsTab="False"
                            Watermark="{i18n:T 每行一条需要额外拾取的完整 OCR 文本}"
                            Text="{Binding PickText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem Header="{i18n:T 不拾取（排除项）}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{i18n:T 启用不拾取规则}" />
                            <TextBlock
                                    Margin="0,3,12,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{i18n:T 精确命中的内容会从默认和用户拾取列表中排除。}"
                                    TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DoNotPickEnabled, Mode=TwoWay}" />
                    </Grid>
                    <TextBox
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AcceptsTab="False"
                            IsEnabled="{Binding DoNotPickEnabled}"
                            Watermark="{i18n:T 每行一条需要从最终拾取列表排除的完整 OCR 文本}"
                            Text="{Binding DoNotPickText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 保存后立即刷新自动拾取规则。}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                        MinWidth="88"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"
                        Content="{i18n:T 取消}"
                        IsCancel="True" />
                <Button
                        Classes="accent"
                        MinWidth="88"
                        Command="{Binding SaveCommand}"
                        Content="{i18n:T 保存}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
