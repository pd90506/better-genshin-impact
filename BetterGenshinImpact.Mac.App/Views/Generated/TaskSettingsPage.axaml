<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:autofight="using:BetterGenshinImpact.GameTask.AutoFight"
    xmlns:combobuild="using:BetterGenshinImpact.GameTask.AutoCombo.ComboBuild"
    xmlns:helpers="using:BetterGenshinImpact.Helpers"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    xmlns:pages="using:BetterGenshinImpact.ViewModel.Pages"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.TaskSettingsPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="{StaticResource PagePadding}">
        <TextBlock
                Margin="0,0,0,12"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{i18n:T 独立任务设置}" />
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动七圣召唤}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 全自动打牌 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoGeniusInvokationUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoGeniusInvokationCommand}"
                            EnableContent="{Binding SwitchAutoGeniusInvokationButtonText}"
                            IsChecked="{Binding SwitchAutoGeniusInvokationEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择卡组}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 选择你想要使用的卡组与策略}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{i18n:T 脚本仓库}"
                            Command="{Binding OpenLocalScriptRepoCommand}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.StrategyList}"
                            SelectedItem="{Binding Config.AutoGeniusInvokationConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="GeniusInvocation" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 设置延时（毫秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 如果频繁出现操作速度过快，操作动画未播放完毕的情况可以添加延时}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="5000"
                            Minimum="0"
                            Value="{Binding Config.AutoGeniusInvokationConfig.SleepDelay, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动伐木}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 装备「王树瑞佑」，通过循环重启游戏刷新并收集木材 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoWoodUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoWoodCommand}"
                            EnableContent="{Binding SwitchAutoWoodButtonText}"
                            IsChecked="{Binding SwitchAutoWoodEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用进出千星奇域刷新树木CD}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 需要确保已解锁并进入过千星奇域}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoWoodConfig.UseWonderlandRefresh, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 循环次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 循环伐木多少次，输入 0 则为无限循环直到手动终止}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding AutoWoodRoundNum, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用OCR伐木数量限制（需1080P以上分辨率）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 伐木后OCR识别并累计木材数，达到上限后自动停止伐木}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoWoodConfig.WoodCountOcrEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 伐木数量上限（原神每日每种木材最多2000）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 启用伐木数量限制后生效，达到配置上限后自动停止伐木}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding AutoWoodDailyMaxCount, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用小道具后的额外延迟（毫秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 如果希望看到使用小道具后获得木材的提示，可以调整这个值}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoWoodConfig.AfterZSleepDelay, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动战斗}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 自动执行选择的战斗策略 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoFightUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoFightCommand}"
                            EnableContent="{Binding SwitchAutoFightButtonText}"
                            IsChecked="{Binding SwitchAutoFightEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择战斗策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 用于战斗}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{i18n:T 脚本仓库}"
                            Command="{Binding OpenLocalScriptRepoCommand}" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            Command="{Binding OpenFightFolderCommand}"
                            Content="{i18n:T 打开目录}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.CombatStrategyList}"
                            SelectedItem="{Binding Config.AutoFightConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="Combat" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 根据技能CD优化出招人员}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 根据填入人或人和cd，来决定当此人元素战技cd未结束时，跳过此人出招，来优化战斗流程，可填入人名或人名数字（用英文逗号分隔），多种用分号分隔，例如：白术；钟离与12。如果人名，则用内置cd检查（或填入数字也小于0），如果是人名和数字，则把数字当做出招cd(秒)。}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoFightConfig.ActionSchedulerByCd, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16,10,52,0">
                    <Expander
                            Classes="card"
                            Margin="0,0,0,12"
                            IsExpanded="False"
                            HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 自动检测战斗结束}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 检测到战斗已经结束的情况下，停止自动战斗功能}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsChecked="{Binding Config.AutoFightConfig.FightFinishDetectEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="16,0,16,0">
                                    <Expander
                                            Classes="card"
                                            Margin="0,0,0,12"
                                            IsExpanded="False"
                                            HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{i18n:T 更快触发战斗结束检查}"
                                                        TextWrapping="Wrap" />
                                                <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{i18n:T 快速检查战斗结束，完成一轮动作后，如果满足条件，则触发一次战斗结束检查。}"
                                                        TextWrapping="Wrap" />
                                                <ToggleSwitch
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Margin="0,0,36,0"
                                                        IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.FastCheckEnabled, Mode=TwoWay}" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <Grid Margin="16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{i18n:T 更快触发战斗结束检查参数}"
                                                        TextWrapping="Wrap" />
                                                <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{i18n:T 快速检查战斗结束的参数，填写数字（秒）时距离上次检查超过该时间则触发检查，填写人名时对应角色动作后触发检查。多项时使用分号分隔，格式如5或5;白术;}"
                                                        TextWrapping="Wrap" />
                                                <TextBox
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        MinWidth="180"
                                                        MaxWidth="800"
                                                        Margin="0,0,36,0"
                                                        Text="{Binding Config.AutoFightConfig.FinishDetectConfig.FastCheckParams, Mode=TwoWay}"
                                                        TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid Margin="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{i18n:T 切人后再执行战斗结束检查}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 将触发战斗结束检查的时机调整为切人后，无需等待上一个动作后摇。目前仅 JSON 策略下生效。}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.CheckAfterSwitchAvatar, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Grid>
                            <Grid Margin="16,0,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 敌人可见时跳过战斗结束检查}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 检测到敌人血条时跳过战斗结束检查。与“旋转寻找敌人位置”互斥。}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.SkipFightEndCheckWhenEnemyVisible, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,0,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 开战后一段时间阻断战斗结束检查（秒）}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 开战后该时间内的战斗结束检查直接视为战斗未结束，默认为0表示不阻断。}" TextWrapping="Wrap" />
                                </StackPanel>
                                <NumericUpDown
                                        Grid.Column="1"
                                        MinWidth="120"
                                        Margin="0,0,36,0"
                                        Value="{Binding Config.AutoFightConfig.FinishDetectConfig.BlockCheckBeforeBattleSeconds, Mode=TwoWay}"
                                        Minimum="0"
                                        Maximum="10" />
                            </Grid>
                            <Grid Margin="16,0,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 派蒙辅助检测}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 按L后当派蒙头像可见时提前跳出战斗结束检测。默认开启。}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.PaimonEndCheckEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,0,16,16" IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.PaimonEndCheckEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 派蒙检测延时（秒）}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 按L后等待该时间再检测派蒙头像，默认为0.1秒}" TextWrapping="Wrap" />
                                </StackPanel>
                                <NumericUpDown
                                        Grid.Column="1"
                                        MinWidth="120"
                                        Margin="0,0,36,0"
                                        Value="{Binding Config.AutoFightConfig.FinishDetectConfig.PaimonEndCheckDelay, Mode=TwoWay}"
                                        Minimum="0.05"
                                        Maximum="0.4" />
                            </Grid>
                            <Grid Margin="16,0,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 旋转寻找敌人位置}"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        FontSize="9"
                                        Text="{i18n:T 旋转速度(建议单次360°左右)：}"
                                        Margin="5,8,0,10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled}" />
                                <Slider
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Minimum="1"
                                        Maximum="13"
                                        Value="{Binding Config.AutoFightConfig.FinishDetectConfig.RotaryFactor, Mode=TwoWay}"
                                        Margin="3,0,5,10"
                                        TickFrequency="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled}" />
                                <ToggleSwitch Grid.Column="3" Margin="10,0,36,10" IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                    Margin="16,0,16,0"
                                    HorizontalAlignment="Stretch"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{i18n:T (建议配合1秒左右“更快检测结束战斗”) 打开队伍界面检测战斗结束前，先检测敌人，判断是否需靠近敌或旋转寻找敌人。(Q前检查：释放Q技能前检测是否结束战斗。尝试面敌：开战寻敌，战斗尝试面向敌人)}"
                                    TextWrapping="Wrap"
                                    IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled}" />
                            <Grid Margin="16,0,16,16" IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T Q前检测}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 释放Q技能前检测是否结束战斗}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsEnabled="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled, Mode=TwoWay}"
                                        IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.CheckBeforeBurst, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,0,16,16" IsVisible="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 尝试面敌}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 开战寻敌，战斗尝试面向敌人}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsEnabled="{Binding Config.AutoFightConfig.FinishDetectConfig.RotateFindEnemyEnabled, Mode=TwoWay}"
                                        IsChecked="{Binding Config.AutoFightConfig.FinishDetectConfig.IsFirstCheck, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 检查战斗结束的延时}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 触发战斗结束检查时，先等待该延时以确保角色动作后摇结束。也可为角色单独指定延时，格式如 0.4 或 0.4;钟离与1.5}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        MinWidth="120"
                                        Text="{Binding Config.AutoFightConfig.FinishDetectConfig.CheckEndDelay}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 按键触发后检查延时}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 按下切换队伍后去检查屏幕色块的延时，默认为0.45秒。若出现无法结束战斗可以适当提高这个值，比如0.75。但不要太大，确保这个延时不会真的把队伍配置界面切出来。}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        MinWidth="120"
                                        Text="{Binding Config.AutoFightConfig.FinishDetectConfig.BeforeDetectDelay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16,10,52,0">
                    <Expander
                            Classes="card"
                            Margin="0,0,0,12"
                            IsExpanded="False"
                            HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 战斗中视觉识别配置}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16,12,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 战斗中持续索敌}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 战斗过程中情况允许时持续尝试面朝敌人}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.EnableCombatTargeting, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,4,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 脱锁等待时间（秒）}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 敌人不可见时等待一定时间后开始旋转索敌}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                        Grid.Column="1"
                                        Width="120"
                                        Margin="0,0,36,0"
                                        Text="{Binding Config.AutoFightConfig.LockLostWaitTime}" />
                            </Grid>
                            <Grid Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 伤害数字识别模式}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 当血条不可见或传奇等固定位置血条时使用伤害数字辅助定位敌人}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                        Grid.Column="1"
                                        Width="120"
                                        Margin="0,0,36,0"
                                        SelectedValue="{Binding Config.AutoFightConfig.DamageNumberRecognitionMode, Mode=TwoWay}"
                                        SelectedValueBinding="{Binding Tag}">
                                    <ComboBoxItem Tag="{x:Static autofight:DamageNumberRecognitionMode.Disabled}" Content="{i18n:T 禁用}" />
                                    <ComboBoxItem Tag="{x:Static autofight:DamageNumberRecognitionMode.Ocr}" Content="{i18n:T OCR识别}" />
                                    <ComboBoxItem Tag="{x:Static autofight:DamageNumberRecognitionMode.Color}" Content="{i18n:T 颜色识别}" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 索敌识别间隔（毫秒）}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 每次索敌识别之间的间隔时间}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                        Grid.Column="1"
                                        Width="120"
                                        Margin="0,0,36,0"
                                        Text="{Binding Config.AutoFightConfig.TargetingDetectionInterval}" />
                            </Grid>
                            <Grid Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 绘制识别结果位置}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 在遮罩窗口上显示血条、伤害数字等识别结果的边框}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.DrawRecognitionResults, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Expander
                        Classes="card"
                        Margin="16,10,52,12"
                        IsExpanded="False"
                        HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{i18n:T 盾奶位角色优先释放技能}"
                                    TextWrapping="Wrap" />
                            <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{i18n:T 战斗过程实时检测和释放盾奶位角E战技（空选为关闭此功能）}"
                                    TextWrapping="Wrap" />
                        </Grid>
                    </Expander.Header>
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{i18n:T 盾奶位角色在队伍中的位置}"
                                TextWrapping="Wrap" />
                        <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T 实时检测盾奶位战技CD}"
                                TextWrapping="Wrap" />
                        <ComboBox
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                MinWidth="80"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="10,0,10,0"
                                ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.AvatarIndexList}}"
                                SelectedItem="{Binding Config.AutoFightConfig.GuardianAvatar, Mode=TwoWay}" />
                        <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                Text="{i18n:T 禁用该角色的战斗策略}"
                                TextWrapping="Wrap" />
                        <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T 自动释放E或Q战技}"
                                TextWrapping="Wrap" />
                        <TextBlock
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Margin="0,0,5,30"
                                FontSize="8"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T E战技}"
                                TextWrapping="Wrap" />
                        <ToggleSwitch
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Margin="0,0,5,0"
                                IsChecked="{Binding Config.AutoFightConfig.GuardianCombatSkip, Mode=TwoWay}"
                                IsVisible="{Binding Config.AutoFightConfig.GuardianAvatar, Converter={x:Static c:TriggerConverter.Instance}, ConverterParameter='|False|True'}" />
                        <TextBlock
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="4"
                                Margin="0,0,36,30"
                                FontSize="8"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T Q爆发}"
                                TextWrapping="Wrap" />
                        <ToggleSwitch
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="4"
                                Margin="0,0,5,0"
                                IsChecked="{Binding Config.AutoFightConfig.BurstEnabled, Mode=TwoWay}"
                                IsVisible="{Binding Config.AutoFightConfig.GuardianAvatar, Converter={x:Static c:TriggerConverter.Instance}, ConverterParameter='|False|True'}" />
                        <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Margin="0,10,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="{i18n:T 检测盾奶位战技短按或长按，禁用:短按 / 启用:长按}"
                                TextWrapping="Wrap" />
                        <ToggleSwitch
                                Grid.Row="2"
                                Grid.Column="4"
                                Margin="0,10,36,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Config.AutoFightConfig.GuardianAvatarHold, Mode=TwoWay}"
                                IsVisible="{Binding Config.AutoFightConfig.GuardianAvatar, Converter={x:Static c:TriggerConverter.Instance}, ConverterParameter='|False|True'}" />
                    </Grid>
                </Expander>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16,10,52,0">
                    <Expander
                            Classes="card"
                            Margin="0,0,0,12"
                            IsExpanded="False"
                            HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 战斗后拾取动作}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 战斗后执行的动作便于拾取掉落物}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16,12,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 扫描掉落物光柱}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 战斗结束后旋转视角寻找掉落物光柱并靠近（仅在无万叶和琴时备用）}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.PickDropsAfterFightEnabled}" />
                            </Grid>
                            <Grid Margin="16,4,16,12" IsVisible="{Binding Config.AutoFightConfig.PickDropsAfterFightEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{i18n:T 扫描掉落物光柱最大时长}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        MinWidth="120"
                                        Text="{Binding Config.AutoFightConfig.PickDropsAfterFightSeconds}" />
                            </Grid>
                            <Grid Margin="16,8,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 聚集材料动作}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 战斗结束后，如存在(万叶/琴)，则执行长E聚集材料动作}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.KazuhaPickupEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,4,16,12" IsVisible="{Binding Config.AutoFightConfig.KazuhaPickupEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 二次拾取}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 琴首次拾取空，再次拾取。万叶即使刚使用过技能，也会强制再次拾取。}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsEnabled="{Binding Config.AutoFightConfig.KazuhaPickupEnabled, Mode=TwoWay}"
                                        IsChecked="{Binding Config.AutoFightConfig.QinDoublePickUp, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16,8,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T 基于经验值判断拾取(经验值57/58/60，不含传奇120等数字)}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 未能检测到经验值图标时跳过战斗后拾取动作}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoFightConfig.ExpBasedPickupEnabled, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Grid>
                <Grid Margin="16,16,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动战斗超时(秒)}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 到达指定时间后，自动停止战斗}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            HorizontalContentAlignment="Center"
                            Margin="10,0,20,0"
                            MinWidth="50"
                            Text="{Binding Config.AutoFightConfig.Timeout}" />
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Text="{i18n:T 游泳检测(自动战斗过程中)}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 先回战斗节点，失败则去七天神像}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Margin="10,0,36,0"
                            HorizontalAlignment="Right"
                            IsChecked="{Binding Config.AutoFightConfig.SwimmingEnabled, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动秘境}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 基于钟离的自动循环刷本 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoDomainUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoDomainCommand}"
                            EnableContent="{Binding SwitchAutoDomainButtonText}"
                            IsChecked="{Binding SwitchAutoDomainEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择战斗策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 用于战斗}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{i18n:T 脚本仓库}"
                            Command="{Binding OpenLocalScriptRepoCommand}" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            Command="{Binding OpenFightFolderCommand}"
                            Content="{i18n:T 打开目录}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.CombatStrategyList}"
                            SelectedItem="{Binding Config.AutoFightConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="Combat" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动切换到指定队伍}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 注意队伍名称是游戏内你手动设置的名称}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoDomainConfig.PartyName, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定要前往的秘境}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 自动传送到刷取的秘境}"
                            TextWrapping="Wrap" />
                    <c:CascadingComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                            SelectedCascadingItem="{Binding Config.AutoDomainConfig.DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 刷取至树脂耗尽}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 优先使用浓缩树脂，然后使用原粹树脂，其余树脂不使用}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.SpecifyResinUse, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定每种树脂刷取次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启后会根据配置的次数使用对应的树脂}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.SpecifyResinUse, Mode=TwoWay}" />
                </Grid>
                <Border
                        Margin="16,8,16,16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8"
                        IsEnabled="{Binding Config.AutoDomainConfig.SpecifyResinUse, Mode=OneWay}">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock Text="{i18n:T 原粹树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoDomainConfig.OriginalResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{i18n:T 浓缩树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoDomainConfig.CondensedResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{i18n:T 须臾树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoDomainConfig.TransientResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="{i18n:T 脆弱树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoDomainConfig.FragileResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 结束后自动分解圣遗物}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 需要快速分解圣遗物的最高星级}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,10,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.ArtifactSalvageStarList}}"
                            SelectedItem="{Binding Config.AutoArtifactSalvageConfig.MaxArtifactStar, Mode=TwoWay}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.AutoArtifactSalvage, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 战斗完成后等待时间（秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 战斗结束后，寻找石化古树前的延迟时间，等一些角色技能完全结束}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoDomainConfig.FightEndDelay, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 寻找古树时使用小步伐行走（正常用户请不要启用）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 如果电脑性能较差，寻找古树时间过久，可以尝试使用这个功能}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.ShortMovement, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 步行前往开启秘境和领取奖励}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 如果电脑性能较差，开启秘境或者领取奖励的F点击不到，可以尝试此功能}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.WalkToF, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 寻找古树时确认位置左右移动的次数（正常用户不要修改）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 小步伐行走的时候左右确认位置的次数}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoDomainConfig.LeftRightMoveTimes, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动吃药}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 请先装备 “便携营养袋” ，在红血时候后自动按Z键吃药}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.AutoEat, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用奖励识别}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 每轮领取后识别奖励名称与数量（图标匹配+OCR双路），任务结束打印汇总}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.RewardRecognitionEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 角色死亡后重试次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 秘境战斗中，发生角色死亡重试的次数}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Text="{Binding Config.AutoDomainConfig.ReviveRetryCount, Mode=TwoWay}"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动首领讨伐}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 自动传送、战斗并领取奖励}"
                            TextWrapping="Wrap" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoBossCommand}"
                            EnableContent="{Binding SwitchAutoBossButtonText}"
                            IsChecked="{Binding SwitchAutoBossEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择战斗策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 仅用于首领讨伐，不覆盖其他策略设置}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="200"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.CombatStrategyListWithoutCombo}"
                            SelectedItem="{Binding Config.AutoBossConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="Combat" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择首领}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 部分首领因机制问题未添加}"
                            TextWrapping="Wrap" />
                    <c:CascadingComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="200"
                            Margin="0,0,36,0"
                            ItemsSource="{x:Static helpers:AutoBossCascadingItems.Items}"
                            SelectedCascadingItem="{Binding Config.AutoBossConfig.BossName, Mode=TwoWay, Converter={StaticResource AutoBossNameConverter}}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 切换队伍}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 留空则不更换队伍}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="200"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoBossConfig.TeamName, Mode=TwoWay}"
                            Watermark="{i18n:T 例如：首领队}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定讨伐次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 关闭时刷取至原粹树脂耗尽，开启后按成功领取奖励次数停止}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoBossConfig.SpecifyRunCount, Mode=TwoWay}" />
                </Grid>
                <Border
                        Margin="16,8,16,16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8"
                        IsVisible="{Binding Config.AutoBossConfig.SpecifyRunCount, Mode=OneWay}">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock Text="{i18n:T 讨伐次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoBossConfig.RunCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="1"
                                    FormatString="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{i18n:T 原粹不足时使用须臾树脂补充：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ToggleSwitch IsChecked="{Binding Config.AutoBossConfig.UseTransientResin, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{i18n:T 原粹不足时使用脆弱树脂补充：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ToggleSwitch IsChecked="{Binding Config.AutoBossConfig.UseFragileResin, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 每轮讨伐后返回七天神像}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启后每次领奖后先回血，再重新前往首领}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoBossConfig.ReturnToStatueAfterEachRound, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用奖励识别}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 每轮领取后识别奖励名称与数量（图标匹配+OCR双路），任务结束打印汇总}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoBossConfig.RewardRecognitionEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 角色死亡后重试次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 战斗中存在角色死亡时，复活后重新讨伐当前首领}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,36,0"
                            Minimum="0"
                            FormatString="0"
                            Increment="1"
                            Value="{Binding Config.AutoBossConfig.ReviveRetryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动战斗超时(秒)}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 到达指定时间后，自动停止战斗}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,36,0"
                            Minimum="0"
                            FormatString="0"
                            Increment="1"
                            Value="{Binding Config.AutoBossConfig.Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动幽境危战}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 自动传送并进入幽境危战 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoStygianOnslaughtUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoStygianOnslaughtCommand}"
                            EnableContent="{Binding SwitchAutoStygianOnslaughtButtonText}"
                            IsChecked="{Binding SwitchAutoStygianOnslaughtEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择战斗策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 用于战斗}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{i18n:T 脚本仓库}"
                            Command="{Binding OpenLocalScriptRepoCommand}" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            Command="{Binding OpenFightFolderCommand}"
                            Content="{i18n:T 打开目录}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.CombatStrategyListWithoutCombo}"
                            SelectedItem="{Binding Config.AutoStygianOnslaughtConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="Combat" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定刷取的战场}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 从上到下战场一、二、三}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.BossNumList}}"
                            SelectedItem="{Binding Config.AutoStygianOnslaughtConfig.BossNum, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定战斗队伍}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 输入预设队伍的名称，留空则不更换队伍}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="200"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoStygianOnslaughtConfig.FightTeamName, Mode=TwoWay}"
                            Watermark="{i18n:T 例如：队伍1}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 刷取至树脂耗尽}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 优先使用浓缩树脂，然后使用原粹树脂，其余树脂不使用}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoStygianOnslaughtConfig.SpecifyResinUse, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 指定每种树脂刷取次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启后会根据配置的次数使用对应的树脂}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoStygianOnslaughtConfig.SpecifyResinUse, Mode=TwoWay}" />
                </Grid>
                <Border
                        Margin="16,8,16,16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8"
                        IsEnabled="{Binding Config.AutoStygianOnslaughtConfig.SpecifyResinUse, Mode=OneWay}">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock Text="{i18n:T 原粹树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoStygianOnslaughtConfig.OriginalResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{i18n:T 浓缩树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoStygianOnslaughtConfig.CondensedResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{i18n:T 须臾树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoStygianOnslaughtConfig.TransientResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="{i18n:T 脆弱树脂刷取次数：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown
                                    Value="{Binding Config.AutoStygianOnslaughtConfig.FragileResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0"
                                    Increment="1"
                                    Width="120" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 结束后自动分解圣遗物}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 需要快速分解圣遗物的最高星级}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,10,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.ArtifactSalvageStarList}}"
                            SelectedItem="{Binding Config.AutoArtifactSalvageConfig.MaxArtifactStar, Mode=TwoWay}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoStygianOnslaughtConfig.AutoArtifactSalvage, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 全自动钓鱼（单个鱼塘）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 不要携带跟宠！在出现钓鱼F按钮的位置启动本任务 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoFishingUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoFishingCommand}"
                            EnableContent="{Binding SwitchAutoFishingButtonText}"
                            IsChecked="{Binding SwitchAutoFishingEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 上钩等待超时时间}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 超过这个时间将自动提竿，并重新识别并选择鱼饵进行抛竿}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="60"
                            Minimum="5"
                            Value="{Binding Config.AutoFishingConfig.AutoThrowRodTimeOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 整个任务超时时间}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 超过这个时间将强制结束任务}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="1800"
                            Minimum="0"
                            Value="{Binding Config.AutoFishingConfig.WholeProcessTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 昼夜策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 钓全天的鱼、还是只钓白天或夜晚的鱼、亦或不调整时间}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="100"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding FishingTimePolicyDict}"
                            SelectedValueBinding="{Binding Key}"
                            DisplayMemberBinding="{Binding Value}"
                            SelectedItem="{Binding Config.AutoFishingConfig.FishingTimePolicy, Converter={StaticResource EnumToKVPConverter}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 关键帧保存截图（开发者）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在流程判断的关键时刻保存当时的截图，供分析判断。会大量写入，非调试时请关闭。需要启用保存截图功能}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsEnabled="{Binding Config.CommonConfig.ScreenshotEnabled}"
                            IsChecked="{Binding SaveScreenshotOnKeyTick, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动地脉花}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 自动定位并刷取地脉花 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoLeyLineOutcropUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoLeyLineOutcropCommand}"
                            EnableContent="{Binding SwitchAutoLeyLineOutcropButtonText}"
                            IsChecked="{Binding SwitchAutoLeyLineOutcropEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 地脉花类型}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 选择刷取的地脉花，启示之花（经验书）或藏金之花（摩拉）。}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="150"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeList}}"
                            SelectedItem="{Binding Config.AutoLeyLineOutcropConfig.LeyLineOutcropType, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 国家}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 按国家选择刷取对应的地脉花。}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryList}}"
                            SelectedItem="{Binding Config.AutoLeyLineOutcropConfig.Country, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 选择战斗策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 用于战斗}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{i18n:T 脚本仓库}"
                            Command="{Binding OpenLocalScriptRepoCommand}" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            Command="{Binding OpenFightFolderCommand}"
                            Content="{i18n:T 打开目录}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Width="180"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoFightViewModel.CombatStrategyListWithoutCombo}"
                            SelectedItem="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.StrategyName, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DropDownOpened">
                                <ia:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}" CommandParameter="Combat" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 根据技能CD优化出招人员}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 根据填入人或人和cd，来决定当此人元素战技cd未结束时，跳过此人出招，来优化战斗流程，可填入人名或人名数字（用英文逗号分隔），多种用分号分隔，例如：白术；钟离与12。如果人名，则用内置cd检查（或填入数字也小于0），如果是人名和数字，则把数字当做出招cd(秒)。}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.ActionSchedulerByCd, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="16,0,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 旋转寻找敌人位置}"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            FontSize="9"
                            Text="{i18n:T 旋转速度(建议单次360°左右)：}"
                            Margin="5,8,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    <Slider
                            Grid.Row="0"
                            Grid.Column="2"
                            Minimum="1"
                            Maximum="13"
                            Value="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.SeekEnemyRotaryFactor, Mode=TwoWay}"
                            Margin="3,0,5,10"
                            TickFrequency="1"
                            IsEnabled="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.SeekEnemyEnabled}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0,0,5,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T (实验性功能) 战斗时按下方设置的间隔尝试靠近或旋转寻找敌人。}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="10,0,36,10"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.SeekEnemyEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16,0,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 寻敌间隔（秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 仅在已启用“旋转寻找敌人位置”后生效，最小 1 秒。}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="120"
                            Minimum="1"
                            Maximum="60"
                            Increment="1"
                            IsEnabled="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.SeekEnemyEnabled}"
                            Value="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.SeekEnemyIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16,16,16,13">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{i18n:T 聚集材料动作}" TextWrapping="Wrap" />
                        <TextBlock
                                Margin="6,0,5,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Text="{i18n:T （二次拾取：琴首次拾取空，再次拾取。万叶即使刚使用过技能，也会强制再次拾取。）}"
                                TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 战斗结束后，如存在(万叶/琴)，则执行长E聚集材料动作}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.KazuhaPickupEnabled, Mode=TwoWay}" />
                    <StackPanel
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,38,0">
                        <ToggleSwitch IsEnabled="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.KazuhaPickupEnabled}" IsChecked="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.QinDoublePickUp, Mode=TwoWay}" />
                        <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T 二次拾取}"
                                TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 领取奖励后扫描掉落物光柱}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在地脉花领奖完成后，短时间扫描周围掉落物光柱并靠近拾取；不依赖万叶或琴。部分点位或特定配队下可能因移动范围较大而卡住，请按需开启。}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding ScanDropsAfterRewardEnabledUi, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 领奖后扫描时长（秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 控制领奖后扫描掉落物光柱的最长时长。设为 0 表示不扫描。}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Minimum="0"
                            Maximum="60"
                            Increment="1"
                            IsEnabled="{Binding ScanDropsAfterRewardEnabledUi}"
                            Value="{Binding Config.AutoLeyLineOutcropConfig.ScanDropsAfterRewardSeconds, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 树脂耗尽模式}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 按当前树脂与库存自动计算可刷次数，结束后自动停止。}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.IsResinExhaustionMode, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 刷取次数取小值}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 与手动次数取最小值，避免超过树脂可用次数。}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.OpenModeCountMin, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 刷取次数}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 树脂耗尽模式关闭或统计失败时使用的固定次数。}" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="999"
                            Minimum="1"
                            Value="{Binding Config.AutoLeyLineOutcropConfig.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用须臾树脂}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 原粹与浓缩耗尽后，允许使用须臾树脂继续刷取。}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.UseTransientResin, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用脆弱树脂}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 原粹与浓缩耗尽后，允许使用脆弱树脂继续刷取。}" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoLeyLineOutcropConfig.UseFragileResin, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 战斗队伍名称}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 进入战斗前切换到该队伍，留空则不切换。}" />
                        <LineBreak />
                        <Run Text="{i18n:T 如果配置了好感队则必须填写。}" />
                    </TextBlock>
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoLeyLineOutcropConfig.Team, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Cursor="IBeam" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 好感队名称}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 领取奖励前切换到该队伍，留空则不切换。}" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoLeyLineOutcropConfig.FriendshipTeam, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Cursor="IBeam" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 战斗超时时间（秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 到达指定时间后，自动停止战斗。}" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Maximum="9999"
                            Minimum="1"
                            Value="{Binding Config.AutoLeyLineOutcropConfig.FightConfig.Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动千音雅集}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 可以自动演奏单个，也可以全自动完成整个专辑 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoMusicGameUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 【乐曲】 演奏单个乐曲}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 进入演奏界面使用，下落模式必须选择垂落模式 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoMusicGameUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoMusicGameCommand}"
                            EnableContent="{Binding SwitchAutoMusicGameButtonText}"
                            IsChecked="{Binding SwitchAutoMusicGameEnabled}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 【专辑】 全自动完成整个专辑}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 进入专辑界面使用，自动演奏未完成乐曲 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToAutoMusicGameUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoAlbumCommand}"
                            EnableContent="{Binding SwitchAutoAlbumButtonText}"
                            IsChecked="{Binding SwitchAutoAlbumEnabled}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 【专辑】 自动演奏未达成【大音天籁】的乐曲}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 关闭时，奖励已经领取就会跳过乐曲。开启时，达成了【大音天籁】才会跳过乐曲}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoMusicGameConfig.MustCanorusLevel, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 【专辑】 自动演奏的目标难度选择}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 设置为【传说】，【大师】即可获取所有奖励，设置【所有】则会对乐曲的所有难度进行自动演奏}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding AutoMusicLevelList}"
                            SelectedItem="{Binding Config.AutoMusicGameConfig.MusicLevel, Mode=TwoWay}"
                            SelectedIndex="0" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 音符检测使用截图管线}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启后音符检测走全局截图器（推荐WGCV2）}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoMusicGameConfig.UseCapturePipeline, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动烹饪}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在手动烹饪界面运行，自动识别并点击结束烹饪}"
                            TextWrapping="Wrap" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoCookCommand}"
                            EnableContent="{Binding SwitchAutoCookButtonText}"
                            IsChecked="{Binding SwitchAutoCookEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 检测间隔（毫秒）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 每次截图检测的时间间隔，最小 1ms}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Minimum="1"
                            Maximum="1000"
                            Value="{Binding Config.AutoCookConfig.CheckIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动结束烹饪任务}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启后检测到“自动烹饪”按钮会点击并结束当前任务}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoCookConfig.StopTaskWhenRecoverButtonDetected, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="自动连招（实验）"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">启动本任务后识别队伍，构建连招行为树</TextBlock>
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Content="{Binding SwitchAutoComboRunButtonText}"
                            Command="{Binding SwitchAutoComboRunCommand}" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="停止"
                            EnableCommand="{Binding SwitchAutoComboCommand}"
                            EnableContent="{Binding SwitchAutoComboButtonText}"
                            IsChecked="{Binding SwitchAutoComboEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16,16,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            TextWrapping="Wrap"
                            Text="{i18n:T LLM服务商}" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T OpenAI 兼容可填任意兼容服务或本机模型；Anthropic 使用官方 Messages API 且服务地址可留空}" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            SelectedValue="{Binding Config.AutoComboBuildConfig.Provider, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Tag}">
                        <ComboBoxItem Tag="{x:Static combobuild:AutoComboLlmProvider.OpenAiCompatible}" Content="{i18n:T OpenAI 兼容}" />
                        <ComboBoxItem Tag="{x:Static combobuild:AutoComboLlmProvider.Anthropic}" Content="Anthropic" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">决策LLM服务地址</TextBlock>
                    <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="必须使用 HTTPS 地址，否则密钥会明文传输；本机地址（localhost/127.0.0.1）除外；Anthropic 可留空使用官方地址，填写时不要带 /v1"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoComboBuildConfig.PlanningLlmEndpoint, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Cursor="IBeam" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">LLM模型名</TextBlock>
                    <Grid
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                                Grid.Column="0"
                                MinHeight="32"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding AutoComboModelNameList}"
                                Text="{Binding Config.AutoComboBuildConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip.Tip="{Binding Config.AutoComboBuildConfig.ModelName}" />
                        <Button Grid.Column="1" Content="{i18n:T 拉取模型列表}" Command="{Binding FetchAutoComboModelListCommand}" />
                    </Grid>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">LLM服务密钥</TextBlock>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="注意保护好密钥"
                            TextWrapping="Wrap" />
                    <TextBox
                            PasswordChar="•"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoComboBuildConfig.ApiKey, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">额外提示词</TextBlock>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="追加给 LLM 的自定义要求，如“使用芭芭拉重击来输出”；留空则不注入"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Height="80"
                            Text="{Binding Config.AutoComboBuildConfig.ExtraPrompt, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">主建树提示词</TextBlock>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="“当前队伍”“元素反应”等小节由程序自动追加，无需填写；留空使用默认正文"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Height="160"
                            Text="{Binding Config.AutoComboBuildConfig.MainPrompt, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">兜底建树提示词</TextBlock>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="“当前队伍”小节由程序自动追加，无需填写；留空使用默认正文"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Height="120"
                            Text="{Binding Config.AutoComboBuildConfig.FallbackPrompt, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalContentAlignment="Top"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock TextWrapping="Wrap">角色提示词覆盖</TextBlock>
                        <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="自定义角色的战术描述，未覆盖的角色使用内置描述；删除行即恢复内置描述；如重复只取第一个"
                                TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                            Grid.Column="1"
                            Margin="12,0,36,0"
                            VerticalAlignment="Center"
                            Command="{Binding AddAvatarDescriptionOverrideCommand}"
                            Content="添加角色" />
                </Grid>
                <ItemsControl Margin="16,0,36,16" ItemsSource="{Binding Config.AutoComboBuildConfig.AvatarDescriptionOverrides}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Static pages:TaskSettingsPageViewModel.CombatAvatarNameList}"
                                        SelectedItem="{Binding Name, Mode=TwoWay}" />
                                <TextBox
                                        Grid.Column="1"
                                        Height="44"
                                        Margin="8,0,0,0"
                                        VerticalContentAlignment="Top"
                                        AcceptsReturn="True"
                                        Text="{Binding Description, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Button
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding #PageRoot.DataContext.RemoveAvatarDescriptionOverrideCommand}"
                                        CommandParameter="{Binding}"
                                        Content="删除" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动分解圣遗物}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 指定匹配表达式逐一筛选分解，支持5星圣遗物 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToArtifactSalvageUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchArtifactSalvageCommand}"
                            EnableContent="{Binding SwitchAutoFishingButtonText}"
                            IsChecked="{Binding SwitchArtifactSalvageEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试识别效果}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 请先将游戏界面切换至圣遗物分解界面}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Content="{i18n:T 打开测试窗口}"
                            Command="{Binding OpenArtifactSalvageTestOCRWindowCommand}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap">
                        JavaScript -
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToArtifactSalvageUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 只要满足的圣遗物都会被选中}" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Content="{i18n:T 从脚本仓库复制}"
                            Command="{Binding CopyArtifactSalvageJavaScriptFromRepositoryCommand}" />
                    <TextBox
                            Grid.Row="2"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoArtifactSalvageConfig.JavaScript, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Cursor="IBeam" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            TextWrapping="Wrap"
                            Text="{i18n:T 按套装筛选}" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 利用游戏自带的筛选功能先行筛选}" />
                        <LineBreak />
                        <Run Text="{i18n:T 一般填写套装内生之花名，可填入多个名称；留空则不用}" />
                    </TextBlock>
                    <TextBox
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="400"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AutoArtifactSalvageConfig.ArtifactSetFilter, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Cursor="IBeam" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 需要快速分解圣遗物的最高星级}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 先会进行一次快速分解选择}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.ArtifactSalvageStarList}}"
                            SelectedItem="{Binding Config.AutoArtifactSalvageConfig.MaxArtifactStar, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 最大检查数量}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 达到最大检查数量后也会停止}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Value="{Binding Config.AutoArtifactSalvageConfig.MaxNumToCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 识别失败策略}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 识别单个圣遗物面板信息失败时，是跳过还是终止}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="100"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding RecognitionFailurePolicyDict}"
                            SelectedValueBinding="{Binding Key}"
                            DisplayMemberBinding="{Binding Value}"
                            SelectedItem="{Binding Config.AutoArtifactSalvageConfig.RecognitionFailurePolicy, Converter={StaticResource EnumToKVPConverter}, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 自动使用兑换码}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Text="{i18n:T 自动使用输入的兑换码}" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchAutoRedeemCodeCommand}"
                            EnableContent="{Binding SwitchAutoRedeemCodeButtonText}"
                            IsChecked="{Binding SwitchAutoRedeemCodeEnabled}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 获取剪切板上的兑换码}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在切换到软件界面时候，自动提取兑换码并提示}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoRedeemCodeConfig.ClipboardListenerEnabled, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander
                Classes="card"
                Margin="0,0,0,12"
                IsVisible="{Binding Config.CommonConfig.ScreenshotEnabled}"
                HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="183*" />
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 截取物品图标（开发者）}"
                            TextWrapping="Wrap"
                            Grid.ColumnSpan="2" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Grid.ColumnSpan="2">
                        <Run Text="{i18n:T 须要打开设置-启用保存截图功能，文件保存在}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToGetGridIconsFolderCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="log/gridIcons" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                        <LineBreak />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToGetGridIconsUrlCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 点击查看使用教程}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,24,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchGetGridIconsCommand}"
                            EnableContent="{Binding SwitchGetGridIconsButtonText}"
                            IsChecked="{Binding SwitchGetGridIconsEnabled}"
                            VerticalAlignment="Top" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 界面名称}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 不同界面的参数不一样，请选择你要扫描的界面}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="150"
                            Margin="0,0,36,0"
                            ItemsSource="{Binding GridNameDict}"
                            SelectedValueBinding="{Binding Key}"
                            DisplayMemberBinding="{Binding Value}"
                            SelectedItem="{Binding Config.GetGridIconsConfig.GridName, Converter={StaticResource EnumToKVPConverter}, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用星星作为名称后缀}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 有些物品具有相同的名称，但具有不同的图标和星星数}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.GetGridIconsConfig.StarAsSuffix, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 使用等级作为名称后缀（待开发）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 有些物品具有相同的名称，但具有不同的图标和等级}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsEnabled="{Binding Config.GetGridIconsConfig.LvAsSuffix, Mode=TwoWay}"
                            IsChecked="{Binding Config.GetGridIconsConfig.LvAsSuffix, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 最大截取数量}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 达到最大截取数量后会停止}"
                            TextWrapping="Wrap" />
                    <NumericUpDown
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="90"
                            Margin="0,0,36,0"
                            Value="{Binding Config.GetGridIconsConfig.MaxNumToGet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试识别效果}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 请先将游戏界面切换至待测试分类界面}"
                            TextWrapping="Wrap" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding SwitchGridIconsModelAccuracyTestCommand}"
                            EnableContent="{Binding SwitchGridIconsAccuracyTestButtonText}"
                            IsChecked="{Binding SwitchGetGridIconsEnabled}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 数量 OCR 测试}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap">
                        <Run Text="{i18n:T 将数量OCR结果截图保存至本地 -}" />
                        <InlineUIContainer>
                            <Button Classes="link" Command="{Binding GoToInventoryCountComparisonFolderCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock>
                                    <Run Text="{i18n:T 打开目录}" />
                                </TextBlock>
                            </Button>
                        </InlineUIContainer>
                    </TextBlock>
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,12,0"
                            ItemsSource="{Binding InventoryCountComparisonTargetDict}"
                            SelectedItem="{Binding InventoryCountComparisonTarget, Converter={StaticResource EnumToKVPConverter}, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Value}" />
                    <c:TwoStateButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="0,0,36,0"
                            DisableCommand="{Binding StopSoloTaskCommand}"
                            DisableContent="{i18n:T 停止}"
                            EnableCommand="{Binding RunInventoryCountComparisonCommand}"
                            EnableContent="{i18n:T 运行}"
                            IsChecked="{Binding SwitchGetGridIconsEnabled}" />
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
