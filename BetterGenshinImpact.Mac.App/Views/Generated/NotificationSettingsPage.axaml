                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 添加机器人好友后发消息获取，可点击下方「绑定」自动获取}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.QqOpenId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 群 OpenID}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 将机器人加入群聊后发消息获取，或在群里 @机器人 获取，可点击下方「绑定群」自动获取}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.QqGroupOpenId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 绑定 OpenID}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 点击绑定后，请用手机 QQ 私聊机器人并发送显示的验证码，系统将自动获取你的 OpenID；绑定过程中可点击取消}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding BindQqCommand}"
                            Content="{i18n:T 绑定}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 绑定群 OpenID}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 点击绑定后，将机器人加入群聊，或在群里 @机器人 发送显示的验证码，系统将自动获取你的群 OpenID；绑定过程中可点击取消}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding BindGroupQqCommand}"
                            Content="{i18n:T 绑定群}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 消息格式}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 选择文字消息的发送格式，不影响图片发送}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            SelectedValue="{Binding Config.NotificationConfig.QqMessageFormat, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Tag}">
                        <ComboBoxItem Content="{i18n:T 普通消息}" Tag="text" />
                        <ComboBoxItem Content="Markdown" Tag="markdown" />
                    </ComboBox>
                </Grid>
                <TextBlock
                        Margin="16,0,16,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding QqStatus}"
                        TextWrapping="Wrap" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试 QQ 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding TestQqNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用微信 Clawbot 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 微信 Clawbot 推送，支持文字和截图（内置实现，无需安装 OpenClaw）}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.WechatClawbotNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="BotToken"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 扫码登录后自动获取，无需手动填写}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.WechatClawbotBotToken, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 目标用户 ID}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 给 Clawbot 发消息后自动获取，无需手动填写}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.WechatClawbotToUserId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 登录并绑定}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 点击后扫码登录，再给 Clawbot 发送显示的验证码完成绑定；过程中可点击取消}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding BindWechatClawbotCommand}"
                            Content="{i18n:T 登录并绑定}" />
                </Grid>
                <TextBlock
                        Margin="16,0,16,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding WechatClawbotStatus}"
                        TextWrapping="Wrap" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试微信 Clawbot 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding TestWechatClawbotNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
