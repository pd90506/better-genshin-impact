                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="160"
                            Margin="0,0,36,0"
                            Command="{Binding TestDiscordNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
