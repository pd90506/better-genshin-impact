                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.EmailNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T SMTP 服务器}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 SMTP 服务器}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.SmtpServer, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T SMTP 服务器端口}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 SMTP 服务器端口，一般为：587}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            MinWidth="60"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.SmtpPort, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T SMTP 用户名}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 SMTP 用户名}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.SmtpUsername, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T SMTP 密码}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 SMTP 密码}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.SmtpPassword, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 发件人邮箱}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写发件人邮箱}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.FromEmail, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 发件人姓名}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写发件人姓名}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.FromName, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 收件人邮箱}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写收件人邮箱}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.ToEmail, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试邮箱通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestEmailNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 Bark 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T Bark ios 推送通知}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.BarkNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T Bark API 端点}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 Bark API 端点，例如：api.day.app}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.BarkApiEndpoint, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 设备 Key}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 多个设备使用英文逗号、分号或空格分隔}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.BarkDeviceKeys, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 推送级别}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 修改推送级别}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            SelectedItem="{Binding Config.NotificationConfig.BarkLevel}"
                            SelectedValueBinding="{Binding Tag}"
                            Margin="0,0,36,0"
                            MinWidth="120">
                        <ComboBoxItem Content="{i18n:T passive（通知但不提醒）}" Tag="passive" />
                        <ComboBoxItem Content="{i18n:T critical（重要通知）}" Tag="critical" />
                        <ComboBoxItem Content="{i18n:T active（默认通知）}" Tag="active" />
                        <ComboBoxItem Content="{i18n:T sensitive（专注通知）}" Tag="timeSensitive" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知声音}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 选择通知声音}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            SelectedValueBinding="{Binding Content}"
                            SelectedValue="{Binding Config.NotificationConfig.BarkSound}"
                            Margin="0,0,36,0"
                            MinWidth="120">
                        <ComboBoxItem Content="minuet" />
                        <ComboBoxItem Content="silence" />
                        <ComboBoxItem Content="bell" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知图标}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 自定义通知图标}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.BarkIcon, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知分组}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 按组显示在通知中心}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.BarkGroup, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 保存推送历史}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 选择是否保存推送历史}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            SelectedValue="{Binding Config.NotificationConfig.BarkIsArchive, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Tag}">
                        <ComboBoxItem Content="{i18n:T 是}" Tag="1" />
                        <ComboBoxItem Content="{i18n:T 否}" Tag="0" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 加密密钥}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 推送内容加密密钥}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.BarkCiphertext, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试 Bark 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestBarkNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 Telegram 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T Telegram 机器人相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.TelegramNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 机器人 Token}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 Telegram 机器人的 Token}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.TelegramBotToken, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 聊天 ID}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写接收消息的聊天 ID}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.TelegramChatId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T API 基础 URL（可选）}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 留空使用官方 API，或填写第三方 API 地址}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.TelegramApiBaseUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用代理}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 是否启用代理连接}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.NotificationConfig.TelegramProxyEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 代理地址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 格式：http://127.0.0.1:7890}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.TelegramProxyUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试 Telegram 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestTelegramNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 xxtui 信息推送}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T xxtui 信息推送通知相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.XxtuiNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T API密钥}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写信息推送通知API密钥}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.XxtuiApiKey, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知来源}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写信息推送通知来源}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.XxtuiFrom, Mode=TwoWay}"
                            Watermark="{i18n:T Better原神}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知渠道}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写信息推送通知渠道}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.XxtuiChannels, Mode=TwoWay}"
                            Watermark="WX_MP／WX_QY_ROBOT／DING_ROBOT／BARK"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试信息推送通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestXxtuiNotificationCommand}"
                            CommandParameter="xxtuiNotifier"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用钉钉机器人通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 钉钉机器人通知相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.DingDingwebhookNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 钉钉机器人通知地址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写钉钉机器人通知地址}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DingdingWebhookUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 钉钉机器人密钥}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写钉钉机器人密钥}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DingDingSecret, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试钉钉机器人通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestDingDingWebhookNotificationCommand}"
                            CommandParameter="DingDingWebhook"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 Discord 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 可选择 Webhook 或机器人两种推送方式}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.DiscordWebhookNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知方式}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 机器人方式可发到多个频道与私信}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="160"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            SelectedValue="{Binding Config.NotificationConfig.DiscordNotificationMode, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Tag}">
                        <ComboBoxItem Content="Webhook" Tag="Webhook" />
                        <ComboBoxItem Content="{i18n:T 机器人（Bot）}" Tag="Bot" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordWebhookMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T Webhook 网址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 Discord 提供的 Webhook 网址}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DiscordWebhookUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordWebhookMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 用户名}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 讯息显示的名称，为空时使用 Discord 中预先设定的名字}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DiscordWebhookUsername, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordWebhookMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 头像网址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 讯息显示的头像，为空时使用 Discord 中预先设定的头像}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DiscordWebhookAvatarUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordBotMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 机器人 Token}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 在 Discord 开发者后台的 Bot 页面复制 Token}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.DiscordBotToken, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordBotMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 消息格式}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 机器人可选择纯文本或嵌入卡片}"
                            TextWrapping="Wrap" />
                    <ComboBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="160"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            SelectedValue="{Binding Config.NotificationConfig.DiscordBotMessageFormat, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Tag}">
                        <ComboBoxItem Content="{i18n:T 普通消息}" Tag="Plain" />
                        <ComboBoxItem Content="{i18n:T 嵌入}" Tag="Embed" />
                    </ComboBox>
                </Grid>
                <Grid Margin="16" IsVisible="{Binding IsDiscordBotMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 推送目标}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding DiscordBotTargetSummary}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="160"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ManageDiscordTargetsCommand}"
                            Content="{i18n:T 管理目标}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
