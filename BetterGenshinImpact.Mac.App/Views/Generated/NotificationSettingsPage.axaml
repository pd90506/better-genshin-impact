<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.NotificationSettingsPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="{StaticResource PagePadding}">
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{i18n:T 通知设置}" />
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 全局通知设置}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 影响下方所有通知的设置}"
                            TextWrapping="Wrap" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 通知时包含截图}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 总是在通知中包含截图}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.NotificationConfig.IncludeScreenShot, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 一条龙结束发送汇总通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 结束时打开地图与冒险之证，推送体力与每日委托奖励汇总及截图}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.NotificationConfig.DragonEndSummaryEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 是否允许 JS 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 开启时允许 JS 脚本发送通知}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.NotificationConfig.JsNotificationEnabled, Mode=TwoWay}" />
                </Grid>
                <StackPanel Margin="16">
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Inlines>
                            <Run Text="{i18n:T 需要通知的事件}" />
                            <Button
                                    Classes="link"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Command="{Binding OpenNotificationEventDocumentCommand}"
                                    Cursor="Hand">
                                <Button.Content>
                                    <TextBlock FontSize="11" Text="{i18n:T 打开文档}" />
                                </Button.Content>
                            </Button>
                        </TextBlock.Inlines>
                    </TextBlock>
                    <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 选择需要通知的事件；全部取消选择后按全部通知处理}"
                            TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding SelectAllNotificationEventsCommand}" Content="{i18n:T 全选}" />
                        <Button Margin="0,0,8,8" Command="{Binding ClearNotificationEventSelectionCommand}" Content="{i18n:T 取消选择}" />
                    </WrapPanel>
                    <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding NotificationEventSelectionSummary}"
                            TextWrapping="Wrap" />
                    <ItemsControl Margin="0,0,-12,0" ItemsSource="{Binding NotificationEventOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding $parent[ItemsControl].ActualWidth, Converter={StaticResource AdaptiveUniformGridColumnsConverter}, ConverterParameter=280|4}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Stretch" Margin="0,0,12,8" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 Webhook}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T Webhook 相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.WebhookEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T Webhook 端点}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 Webhook 端点}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.WebhookEndpoint, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 发送对象}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写发送对象}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.WebhookSendTo, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试载荷}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Margin="0,0,36,0"
                            HorizontalAlignment="Right"
                            Command="{Binding TestWebhookCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 WebSocket}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T WebSocket 相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.WebSocketNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T WebSocket 端点}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 WebSocket 端点}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.WebSocketEndpoint, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试 WebSocket 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestWebSocketNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 Windows 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T Windows 通知别与游戏界面重叠，否则易误点通知}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.WindowsUwpNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试 Windows 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestWindowsUwpNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用飞书通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 飞书通知相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.FeishuNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 飞书通知地址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写飞书通知地址}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.FeishuWebhookUrl, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 飞书AppId}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 若填写AppId、AppSecret则发送图片}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.FeishuAppId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 飞书AppSecret}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 若填写AppId、AppSecret则发送图片}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.FeishuAppSecret, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 测试飞书通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 发送测试通知}"
                            TextWrapping="Wrap" />
                    <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,36,0"
                            Command="{Binding TestFeishuNotificationCommand}"
                            Content="{i18n:T 发送}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 启用 OneBot 通知}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T OneBot 通知相关设置}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.OneBotNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T OneBot 请求地址}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写 OneBot 请求地址}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.OneBotEndpoint, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T QQ 号}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写接收消息的 QQ 号}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.OneBotUserId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{i18n:T 群号}"
                            TextWrapping="Wrap" />
                    <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T 填写接收消息的群号}"
                            TextWrapping="Wrap" />
                    <TextBox
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            MinWidth="180"
                            MaxWidth="800"
                            Margin="0,0,36,0"
                            Text="{Binding Config.NotificationConfig.OneBotGroupId, Mode=TwoWay}"
                            TextWrapping="NoWrap" />
                </Grid>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Token"
                            TextWrapping="Wrap" />
