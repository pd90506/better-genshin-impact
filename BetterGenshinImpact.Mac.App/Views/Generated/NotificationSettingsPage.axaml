                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{i18n:T QQ 官方推送，支持文字和截图}"
                            TextWrapping="Wrap" />
                    <ToggleSwitch
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            IsChecked="{Binding Config.NotificationConfig.QqNotificationEnabled, Mode=TwoWay}" />
                </Grid>
            </Expander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
