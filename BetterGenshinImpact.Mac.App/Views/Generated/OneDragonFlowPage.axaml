<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:helpers="using:BetterGenshinImpact.Helpers"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    xmlns:local="using:BetterGenshinImpact.View.Pages"
    xmlns:pages="using:BetterGenshinImpact.ViewModel.Pages"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.OneDragonFlowPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="22,16,8,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" ContextMenuOpening="DockPanel_ContextMenuOpening">
            <DockPanel.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding AddTaskGroupCommand}" Header="{i18n:T 新增配置}" />
                    <MenuItem Command="{Binding DeleteTaskGroupCommand}" CommandParameter="{Binding #PageRoot.SelectedItem}" Header="{i18n:T 删除}" />
                    <Separator />
                    <MenuItem Command="{Binding NextTaskGroupCommand}" CommandParameter="{Binding #PageRoot.SelectedItem}" Header="{i18n:T 从此执行}" />
                    <MenuItem Command="{Binding ClearNextTaskGroupCommand}" Header="{i18n:T 清除标记}" />
                </ContextMenu>
            </DockPanel.ContextMenu>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                        Grid.Column="0"
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{i18n:T 任务列表}" />
                <Button
                        Classes="accent"
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="0,0,10,0"
                        Command="{Binding OneKeyExecuteCommand}" />
                <Button
                        Grid.Column="2"
                        Grid.Row="0"
                        Margin="0,0,10,0"
                        x:Name="AddTaskGroupButton"
                        Click="AddTaskGroupButton_Click" />
                <Popup
                        x:Name="AddConfigGroupPopup"
                        Placement="Absolute"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                    <Border
                            CornerRadius="8"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            BorderThickness="1"
                            MinWidth="300"
                            MaxHeight="400">
                        <StackPanel Margin="16">
                            <TextBlock
                                    Text="{i18n:T 选择增加的配置组（可多选）}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center" />
                            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ScriptGroupItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Tag="{Binding}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button
                                        Content="{i18n:T 确认}"
                                        Width="70"
                                        Margin="0,0,10,0"
                                        Click="ConfirmButton_Click" />
                                <Button Content="{i18n:T 取消}" Width="70" Click="CancelButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Separator Grid.Row="0" Margin="0,1.5,6,0" BorderThickness="0,1,0,0" />
            </Grid>
            <ContentControl />
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="16,0,0,0">
            <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                <Grid Margin="0,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            Grid.Column="0"
                            FontSize="16"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Text="{i18n:T 配置}"
                            x:Name="ConfigListGrid" />
                    <ComboBox
                            Grid.Column="1"
                            MinWidth="200"
                            Height="34"
                            Margin="10,0,10,0"
                            DisplayMemberBinding="{Binding Name}"
                            ItemsSource="{Binding ConfigList}"
                            SelectedItem="{Binding SelectedConfig, Mode=TwoWay}" />
                    <Button Grid.Column="2" Margin="0,0,10,0" Command="{Binding AddConfigCommand}" />
                    <Button Grid.Column="3" Margin="0,0,10,0" Command="{Binding RenameConfigCommand}" />
                    <Button Grid.Column="4" Margin="0,0,10,0" Command="{Binding DeleteConfigCommand}" />
                </Grid>
                <Separator Margin="0,5,0,0" BorderThickness="0,1,0,0" />
            </StackPanel>
            <ScrollViewer>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock
                            Margin="4,0,0,4"
                            FontSize="14"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{i18n:T 合成树脂}" />
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Text="{i18n:T 合成树脂合成台}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin=" 0,0,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 指定地区合成树脂}"
                                        TextWrapping="Wrap" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        Margin="18,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Left"
                                        SelectedItem="{Binding SelectedConfig.CraftingBenchCountry, Mode=TwoWay}"
                                        ItemsSource="{Binding CraftingBenchCountry}" />
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin=" 15,0,0,0"
                                        HorizontalAlignment="Left"
                                        Text="{i18n:T 合成后保留}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin=" 15,0,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 原粹树脂数量}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Grid.RowSpan="2"
                                        Margin="8,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        Text="{Binding SelectedConfig.MinResinToKeep, Mode=TwoWay, TargetNullValue=-1}"
                                        Height="{Binding ActualHeight, ElementName=combinedTextBlocks}" />
                            </Grid>
                        </c:CardControl.Header>
                    </c:CardControl>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,4">
                        <TextBlock FontSize="14" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="{i18n:T 自动秘境}" />
                        <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="{i18n:T （此处未覆盖的配置可在 独立任务-自动秘境 中配置）}" />
                    </StackPanel>
                    <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 每日秘境刷取配置}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 前往指定秘境消耗树脂，并自动领取奖励。}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        IsChecked="{Binding SelectedConfig.WeeklyDomainEnabled, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 进入秘境切换的队伍名称}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 注意是游戏内你设置的名称}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        MinWidth="150"
                                        MaxWidth="800"
                                        Margin="20,0,36,0"
                                        Text="{Binding SelectedConfig.PartyName, Mode=TwoWay}"
                                        Watermark="{i18n:T 留空则不切换队伍}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Text="{i18n:T 选择秘境}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Left"
                                        Text="{i18n:T 秘境名称}"
                                        TextWrapping="Wrap" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Margin="10,0,10,0"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="10,0,10,0"
                                        HorizontalAlignment="Right"
                                        Text="{i18n:T 周日或限时}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="10,0,10,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right"
                                        Text="{i18n:T 选择序号}"
                                        TextWrapping="Wrap" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Grid.RowSpan="2"
                                        MinWidth="60"
                                        Margin="0,0,36,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding SundayEverySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.SundayEverySelectedValue, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 每周秘境刷取配置}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 启用后，每日刷取配置将会失效。}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        IsChecked="{Binding SelectedConfig.WeeklyDomainEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{i18n:T 周期始于凌晨 4:00 ，如周一 4:00 至周二 3:59 刷取周一秘境}"
                                    TextWrapping="Wrap" />
                            <Grid Margin="20,16,20,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 日期}"
                                        TextAlignment="Center" />
                                <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 队伍}"
                                        TextAlignment="Center" />
                                <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,8,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 秘境}"
                                        TextAlignment="Center" />
                                <TextBlock
                                        Grid.Column="3"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 奖励}"
                                        TextAlignment="Center" />
                            </Grid>
                            <Grid Margin="20,8,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 默认}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.PartyName, Mode=TwoWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Watermark="{i18n:T 留空则不切换队伍}" />
                                <c:CascadingComboBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.SundayWeeklySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周一}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.MondayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.MondayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.MondaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周二}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.TuesdayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.TuesdayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.TuesdaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周三}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.WednesdayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.WednesdayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.WednesdaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周四}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.ThursdayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.ThursdayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.ThursdaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周五}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.FridayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.FridayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.FridaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周六}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.SaturdayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.SaturdayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.SaturdaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Text="{i18n:T 周日}"
                                        VerticalAlignment="Center" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        Text="{Binding SelectedConfig.SundayPartyName, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Watermark="{i18n:T 留空使用默认队伍}" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.SundayDomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        MinWidth="56"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding SundaySelectedValueList}"
                                        SelectedItem="{Binding SelectedConfig.SundaySelectedValue, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.RowSpan="2"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,0"
                                        Content="{i18n:T 领奖树脂设定}"
                                        x:Name="ToggleButton" />
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Text="{i18n:T 分解圣遗物}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 最高的星级}"
                                        TextWrapping="Wrap" />
                                <Popup
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        x:Name="ResinPopup"
                                        Placement="Center"
                                        PlacementTarget="{Binding ElementName=ToggleButton}"
                                        IsOpen="{Binding IsChecked, ElementName=ToggleButton}"
                                        PopupAnimation="Fade"
                                        HorizontalAlignment="Center"
                                        StaysOpen="False">
                                    <Border
                                            CornerRadius="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource  ApplicationBackgroundBrush}"
                                            BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,0">
                                        <StackPanel Margin="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                        Grid.Column="0"
                                                        Margin="0,0,0,0"
                                                        IsChecked="{Binding Config.AutoDomainConfig.SpecifyResinUse, Mode=TwoWay}"
                                                        Content="{i18n:T 模式切换}" />
                                                <TextBlock
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Text="{i18n:T 先用浓缩，后原粹，其余不用}"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        TextWrapping="Wrap"
                                                        IsVisible="{Binding !Config.AutoDomainConfig.SpecifyResinUse}" />
                                                <TextBlock
                                                        Grid.Column="1"
                                                        Margin="5,0,0,0"
                                                        FontSize="14"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Text="{i18n:T 按下方配置数量使用树脂}"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        TextWrapping="Wrap"
                                                        IsVisible="{Binding Config.AutoDomainConfig.SpecifyResinUse}" />
                                            </Grid>
                                            <StackPanel Margin="0,10,0,0" IsEnabled="{Binding Config.AutoDomainConfig.SpecifyResinUse}" IsVisible="{Binding Config.AutoDomainConfig.SpecifyResinUse}">
                                                <Separator Height="1" Margin="0,0,0,0" Background="Gray" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                                    <TextBlock
                                                            Text="{i18n:T 原粹树脂刷取次数：}"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Margin="0,0,8,0" />
                                                    <NumericUpDown
                                                            Value="{Binding Config.AutoDomainConfig.OriginalResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Increment="1"
                                                            Width="120" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock
                                                            Text="{i18n:T 浓缩树脂刷取次数：}"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Margin="0,0,8,0" />
                                                    <NumericUpDown
                                                            Value="{Binding Config.AutoDomainConfig.CondensedResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Increment="1"
                                                            Width="120" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock
                                                            Text="{i18n:T 须臾树脂刷取次数：}"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Margin="0,0,8,0" />
                                                    <NumericUpDown
                                                            Value="{Binding Config.AutoDomainConfig.TransientResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Increment="1"
                                                            Width="120" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock
                                                            Text="{i18n:T 脆弱树脂刷取次数：}"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Margin="0,0,8,0" />
                                                    <NumericUpDown
                                                            Value="{Binding Config.AutoDomainConfig.FragileResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Minimum="0"
                                                            Increment="1"
                                                            Width="120" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </c:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                    Width="60"
                                    Margin="0,0,10,0"
                                    ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.ArtifactSalvageStarList}}"
                                    SelectedItem="{Binding Config.AutoArtifactSalvageConfig.MaxArtifactStar, Mode=TwoWay}" />
                            <ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding Config.AutoDomainConfig.AutoArtifactSalvage, Mode=TwoWay}" />
                        </StackPanel>
                    </c:CardControl>
                    <c:CardControl Margin="0,0,0,4">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 启用奖励识别}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 每轮领取后识别奖励名称与数量，任务结束打印汇总}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </c:CardControl.Header>
                        <ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding Config.AutoDomainConfig.RewardRecognitionEnabled, Mode=TwoWay}" />
                    </c:CardControl>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,4">
                        <TextBlock FontSize="14" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="{i18n:T 自动首领讨伐}" />
                    </StackPanel>
                    <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 自动首领讨伐配置}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 自动传送、战斗并领取奖励}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 选择战斗策略}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 仅用于首领讨伐，不覆盖其他策略设置}"
                                        TextWrapping="Wrap" />
                                <ComboBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="0,0,36,0"
                                        ItemsSource="{Binding AutoFightViewModel.CombatStrategyListWithoutCombo}"
                                        SelectedItem="{Binding SelectedConfig.AutoBossStrategyName, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 选择首领}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 部分首领因机制问题未添加}"
                                        TextWrapping="Wrap" />
                                <c:CascadingComboBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="0,0,36,0"
                                        ItemsSource="{x:Static helpers:AutoBossCascadingItems.Items}"
                                        SelectedCascadingItem="{Binding SelectedConfig.AutoBossName, Mode=TwoWay, Converter={StaticResource AutoBossNameConverter}}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 切换队伍}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 留空则不更换队伍}"
                                        TextWrapping="Wrap" />
                                <TextBox
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="200"
                                        Margin="0,0,36,0"
                                        Text="{Binding SelectedConfig.AutoBossTeamName, Mode=TwoWay}"
                                        Watermark="{i18n:T 例如：首领队}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 成功领奖次数限制}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 开启后，可分别限制单次运行和跨运行累计的成功领奖次数}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsChecked="{Binding SelectedConfig.AutoBossSpecifyRunCount, Mode=TwoWay}" />
                            </Grid>
                            <Border
                                    Margin="16,8,16,16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    IsVisible="{Binding SelectedConfig.AutoBossSpecifyRunCount, Mode=OneWay}">
                                <StackPanel Margin="12">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                        <TextBlock Text="{i18n:T 单次运行上限：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown
                                                Value="{Binding SelectedConfig.AutoBossRunCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Minimum="1"
                                                FormatString="0"
                                                Increment="1"
                                                Width="120" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{i18n:T 原粹不足时使用须臾树脂补充：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ToggleSwitch IsChecked="{Binding SelectedConfig.AutoBossUseTransientResin, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{i18n:T 原粹不足时使用脆弱树脂补充：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ToggleSwitch IsChecked="{Binding SelectedConfig.AutoBossUseFragileResin, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="{i18n:T 累计运行上限：}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <NumericUpDown
                                                Width="120"
                                                Minimum="0"
                                                FormatString="0"
                                                Increment="1"
                                                Value="{Binding SelectedConfig.AutoBossTotalRunCountLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                TextWrapping="Wrap">
                                            <Run Text="{i18n:T 当前已累计成功领奖 }" />
                                            <Run Text="{Binding SelectedConfig.AutoBossCompletedRunCount, Mode=OneWay}" />
                                            <Run Text="{i18n:T  次；累计上限为 0 时不限制}" />
                                        </TextBlock>
                                        <Button
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding ResetAutoBossCompletedRunCountCommand}"
                                                Content="{i18n:T 清空累计}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 每轮讨伐后返回七天神像}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 开启后每次领奖后先回血，再重新前往首领}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsChecked="{Binding SelectedConfig.AutoBossReturnToStatueAfterEachRound, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 启用奖励识别}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 每轮领取后识别奖励名称与数量，任务结束打印汇总}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,36,0"
                                        IsChecked="{Binding SelectedConfig.AutoBossRewardRecognitionEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 角色死亡后重试次数}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 战斗中存在角色死亡时，复活后重新讨伐当前首领}"
                                        TextWrapping="Wrap" />
                                <NumericUpDown
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="120"
                                        Margin="0,0,36,0"
                                        Minimum="0"
                                        FormatString="0"
                                        Increment="1"
                                        Value="{Binding SelectedConfig.AutoBossReviveRetryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,4">
                        <TextBlock FontSize="14" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Text="{i18n:T 自动地脉花}" />
                        <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="{i18n:T （具体参数在 独立任务-自动地脉花 中配置）}" />
                    </StackPanel>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 跳过准备流程}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 跳过部分准备流程（例如传送回七天神像）。}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        IsChecked="{Binding SelectedConfig.LeyLineOneDragonMode, Mode=TwoWay}" />
                            </Grid>
                        </c:CardControl.Header>
                    </c:CardControl>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 树脂耗尽模式}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 按当前树脂与库存自动计算可刷次数，结束后自动停止。}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        IsChecked="{Binding SelectedConfig.LeyLineResinExhaustionMode, Mode=TwoWay}" />
                            </Grid>
                        </c:CardControl.Header>
                    </c:CardControl>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 刷取次数取小值}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 与手动次数取最小值，避免超过树脂可用次数。}"
                                        TextWrapping="Wrap" />
                                <ToggleSwitch
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        IsChecked="{Binding SelectedConfig.LeyLineOpenModeCountMin, Mode=TwoWay}" />
                            </Grid>
                        </c:CardControl.Header>
                    </c:CardControl>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 刷取次数}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 填 0 则使用独立任务配置。}"
                                        TextWrapping="Wrap" />
                                <NumericUpDown
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Margin="0,0,20,0"
                                        Width="120"
                                        Value="{Binding SelectedConfig.LeyLineRunCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="0"
                                        Increment="1" />
                            </Grid>
                        </c:CardControl.Header>
                    </c:CardControl>
                    <Expander Classes="card" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 运行日期配置}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 按星期设置类型与国家}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Text="{i18n:T 运行日期与地脉花设置}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Margin="0,0,0,12"
                                        Text="{i18n:T 仅在勾选的星期执行；若未勾选任何星期，则每天执行。类型/国家留空时使用独立任务默认设置。}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="0,0,12,4"
                                        Text="{i18n:T 类型}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Margin="0,0,0,4"
                                        Text="{i18n:T 国家}"
                                        TextWrapping="Wrap" />
                                <CheckBox
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Content="{i18n:T 周一}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunMonday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineMondayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineMondayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Content="{i18n:T 周二}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunTuesday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineTuesdayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineTuesdayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Content="{i18n:T 周三}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunWednesday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineWednesdayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="5"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineWednesdayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Content="{i18n:T 周四}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunThursday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineThursdayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="6"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineThursdayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Content="{i18n:T 周五}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunFriday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineFridayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="7"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineFridayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        Content="{i18n:T 周六}"
                                        Margin="0,0,12,8"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunSaturday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="8"
                                        Grid.Column="2"
                                        Margin="0,0,12,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineSaturdayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="8"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineSaturdayCountry, Mode=TwoWay}" />
                                <CheckBox
                                        Grid.Row="9"
                                        Grid.Column="0"
                                        Content="{i18n:T 周日}"
                                        Margin="0,0,12,0"
                                        IsChecked="{Binding SelectedConfig.LeyLineRunSunday, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="9"
                                        Grid.Column="2"
                                        Margin="0,0,12,0"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropTypeListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineSundayType, Mode=TwoWay}" />
                                <ComboBox
                                        Grid.Row="9"
                                        Grid.Column="3"
                                        ItemsSource="{Binding Source={x:Static pages:TaskSettingsPageViewModel.LeyLineOutcropCountryListWithEmpty}}"
                                        SelectedItem="{Binding SelectedConfig.LeyLineSundayCountry, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <TextBlock
                            Margin="4,0,0,4"
                            FontSize="14"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{i18n:T 领取奖励}" />
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 领取奖励的冒险者协会}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 前往指定地区冒险者协会领取}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </c:CardControl.Header>
                        <ComboBox
                                MinWidth="100"
                                Margin="0,0,28,0"
                                SelectedItem="{Binding SelectedConfig.AdventurersGuildCountry, Mode=TwoWay}"
                                ItemsSource="{Binding AdventurersGuildCountry}" />
                    </c:CardControl>
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 领取前切换队伍（好感队）}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 用于给指定队伍加好感度}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </c:CardControl.Header>
                        <TextBox
                                MinWidth="150"
                                MaxWidth="800"
                                Margin="0,0,28,0"
                                Text="{Binding SelectedConfig.DailyRewardPartyName, Mode=TwoWay}"
                                Watermark="{i18n:T 填写好感队名称}"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap" />
                    </c:CardControl>
                    <TextBlock
                            Margin="4,0,0,4"
                            FontSize="14"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{i18n:T 尘歌壶配置}" />
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 进壶方式选择}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 购买日期和商品}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </c:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox
                                    MinWidth="90"
                                    Margin="0,0,10,0"
                                    SelectedItem="{Binding SelectedConfig.SereniteaPotTpType, Mode=TwoWay}"
                                    ItemsSource="{Binding SereniteaPotTpTypes}" />
                            <ToggleButton
                                    Margin="0,0,28,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    MinWidth="90"
                                    Height="36"
                                    Padding="0"
                                    ClickMode="Press"
                                    Content="{i18n:T 购买选择}"
                                    Click="SereniteaPotTpType_Clicked"
                                    x:Name="PotButton" />
                            <Popup
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    x:Name="Popup"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=ConfigListGrid}"
                                    IsOpen="{Binding IsChecked, ElementName=PotButton}"
                                    PopupAnimation="Fade"
                                    HorizontalAlignment="Center"
                                    StaysOpen="False"
                                    Margin="12">
                                <Border
                                        CornerRadius="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource  ApplicationBackgroundBrush}"
                                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        BorderThickness="1"
                                        MaxWidth="300"
                                        Margin="12">
                                    <StackPanel Margin="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="5,5,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 日期不影响领取好感和钱币}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <ComboBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    MinWidth="150"
                                                    Margin="5,5,5,5"
                                                    ItemsSource="{x:Static local:OneDragonFlowPage.SereniteaPotSchedule}"
                                                    x:Name="SereniteaPotComboBox" />
                                            <Separator
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="5,3,5,3"
                                                    BorderThickness="0,1,0,0" />
                                            <CheckBox
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding SelectedConfig.SecretTreasureObjects[1], Mode=TwoWay}"
                                                    x:Name="ClothCheckBox" />
                                            <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 布匹}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="MomentResinCheckBox" />
                                            <TextBlock
                                                    Grid.Row="4"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 须臾树脂}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="5"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="SereniteapotExpBookCheckBox" />
                                            <TextBlock
                                                    Grid.Row="5"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 大英雄的经验}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="6"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="SereniteapotExpBookSmallCheckBox" />
                                            <TextBlock
                                                    Grid.Row="6"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 流浪者的经验}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="7"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="MagicmineralprecisionCheckBox" />
                                            <TextBlock
                                                    Grid.Row="7"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 精锻用魔矿}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="8"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="MOlaCheckBox" />
                                            <TextBlock
                                                    Grid.Row="8"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 摩拉}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="9"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="ExpBottleBigCheckBox" />
                                            <TextBlock
                                                    Grid.Row="9"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 祝圣精华}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                            <CheckBox
                                                    Grid.Row="10"
                                                    Grid.Column="0"
                                                    Margin="5,0,5,5"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    x:Name="ExpBottleSmallCheckBox" />
                                            <TextBlock
                                                    Grid.Row="10"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,5"
                                                    FontSize="14"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{i18n:T 祝圣油膏}"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    TextWrapping="Wrap" />
                                        </Grid>
                                        <Separator Margin="5,0,5,5" BorderThickness="0,1,0,0" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Width="70"
                                                    Margin="15,0,5,5"
                                                    Content="{i18n:T 确定}"
                                                    x:Name="PopupConfirmButton"
                                                    Click="SereniteaPotTpType_Clicked" />
                                            <Button
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Width="70"
                                                    Margin="5,0,5,5"
                                                    Content="{i18n:T 取消}"
                                                    x:Name="PopupCloseButton"
                                                    Click="SereniteaPotTpType_Clicked" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </c:CardControl>
                    <TextBlock
                            Margin="4,0,0,4"
                            FontSize="14"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{i18n:T 完成后操作}" />
                    <c:CardControl Margin="0,0,0,12">
                        <c:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{i18n:T 任务完成后执行的操作}"
                                        TextWrapping="Wrap" />
                                <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{i18n:T 一条龙结束后操作}"
                                        TextWrapping="Wrap" />
                            </Grid>
                        </c:CardControl.Header>
                        <ComboBox
                                MinWidth="150"
                                Margin="0,0,28,0"
                                SelectedItem="{Binding SelectedConfig.CompletionAction, Mode=TwoWay}"
                                ItemsSource="{Binding CompletionActionList}" />
                    </c:CardControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
