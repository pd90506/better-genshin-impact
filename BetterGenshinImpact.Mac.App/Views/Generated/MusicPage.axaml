<!-- 由 tools/wpf2avalonia.py 从原版 WPF 页面生成，请勿手动修改；需要调整时修改转换脚本或在 Views/Pages 中另写页面 -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:BetterGenshinImpact.MacApp.Controls"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:i18n="using:BetterGenshinImpact.MacApp.Markup"
    x:Class="BetterGenshinImpact.MacApp.Views.Generated.MusicPage" x:Name="PageRoot" FontFamily="{StaticResource TextThemeFontFamily}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,10,24,10">
            <Border Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                VerticalAlignment="Center"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="{i18n:T 我的曲库}" />
                        <TextBlock
                                Grid.Column="1"
                                Margin="14,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                ToolTip.Tip="{Binding Config.MusicConfig.MusicFolder}">
                            <Run Text="{i18n:T 曲谱目录：}" />
                            <Run Text="{Binding MusicFolderDisplayText, Mode=OneWay}" />
                        </TextBlock>
                        <Button
                                Grid.Column="2"
                                Width="36"
                                Height="34"
                                Margin="0,0,7,0"
                                Command="{Binding OpenFolderCommand}"
                                ToolTip.Tip="{i18n:T 打开当前目录}" />
                        <Button
                                Classes="accent"
                                Grid.Column="3"
                                Height="34"
                                Margin="0,0,7,0"
                                Command="{Binding ChooseFolderCommand}"
                                Content="{i18n:T 选择目录}" />
                        <Button
                                Grid.Column="4"
                                Height="34"
                                Margin="0,0,7,0"
                                Command="{Binding DeleteMusicFolderCommand}"
                                CommandParameter="{Binding SelectedValue, ElementName=MusicFolderHistoryComboBox}"
                                Content="{i18n:T 删除记录}" />
                        <Button
                                Grid.Column="5"
                                Height="34"
                                Command="{Binding OpenSettingsCommand}"
                                Content="{i18n:T 设置}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                                x:Name="MusicFolderHistoryComboBox"
                                DisplayMemberBinding="{Binding DisplayName}"
                                ItemsSource="{Binding MusicFolderHistory}"
                                SelectedValue="{Binding SelectedMusicFolder, Mode=OneWay}"
                                SelectedValueBinding="{Binding FullPath}"
                                ToolTip.Tip="{i18n:T 历史目录：切换曲谱目录}" />
                        <TextBox
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                Watermark="{i18n:T 搜索曲名、作者或路径}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                ItemsSource="{Binding FormatFilters}"
                                SelectedItem="{Binding SelectedFormatFilter}"
                                ToolTip.Tip="{i18n:T 按格式筛选}" />
                        <ComboBox
                                Grid.Column="4"
                                ItemsSource="{Binding InstrumentFilters}"
                                SelectedItem="{Binding SelectedInstrumentFilter}"
                                ToolTip.Tip="{i18n:T 按乐器筛选}" />
                        <Button
                                Grid.Column="5"
                                Width="44"
                                Height="34"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip.Tip="{i18n:T 重新扫描曲谱目录}">
                            <Grid Width="18" Height="18">
                                <ProgressBar
                                        IsIndeterminate="True"
                                        Width="18"
                                        Height="18"
                                        IsVisible="{Binding IsRefreshing}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2" Margin="6,0,6,6">
                        <ListBox
                                x:Name="MusicListView"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding MusicItemsView}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedMusicItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                            x:Name="TrackCard"
                                            Margin="2,1"
                                            Padding="10,6"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            ToolTip.Tip="{Binding Error}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                    x:Name="TrackIconBackground"
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="9">
                                                <Grid>
                                                    <Image x:Name="TrackArtwork" Source="{Binding Artwork}" Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <RectangleGeometry RadiusX="9" RadiusY="9" Rect="0,0,34,34" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayTitle}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding Author, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding FormatName, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding Instrument, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel
                                                    Grid.Column="2"
                                                    MinWidth="76"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding DurationText}" />
                                                <TextBlock
                                                        x:Name="TrackStatusText"
                                                        Margin="0,2,0,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{i18n:T 可演奏 }" />
                                                    <Run Text="{Binding PlayableRatioText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Padding="30" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" IsVisible="{Binding !HasMusicItems}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="20">
                                    <Grid>
                                        <ProgressBar
                                                IsIndeterminate="True"
                                                Width="30"
                                                Height="30"
                                                IsVisible="{Binding IsRefreshing}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="{i18n:T 曲库还是空的}" />
                                <TextBlock
                                        MaxWidth="300"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding LibraryStatusText}"
                                        TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border
                Grid.Row="1"
                MinHeight="100"
                Margin="0"
                Padding="0"
                BorderThickness="0,1,0,0"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Slider
                        Height="26"
                        Margin="0,-13,0,0"
                        ZIndex="2"
                        VerticalAlignment="Top"
                        Maximum="{Binding TotalDurationMilliseconds}"
                        Minimum="0"
                        Value="{Binding CurrentPositionMilliseconds, Mode=TwoWay}" />
                <Grid Margin="20,7,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding CurrentTimeText}" />
                    <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TotalTimeText}" />
                </Grid>
                <Grid Grid.Row="1" Margin="20,7,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel MinWidth="180" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                                Width="46"
                                Height="46"
                                Margin="0,0,11,0"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="12">
                            <Grid>
                                <Image Source="{Binding CurrentMusicItem.Artwork}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,46,46" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                    MaxWidth="260"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentTrackName}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding CurrentMusicItem.FormatName, Mode=OneWay, TargetNullValue='Waiting for playback'}" />
                                <Run Text=" · " />
                                <Run Text="{Binding CurrentMusicItem.Instrument, Mode=OneWay, TargetNullValue=--}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button
                                Width="44"
                                Height="44"
                                Margin="3,0"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="{i18n:T 上一首}" />
                        <Button
                                Classes="accent"
                                Width="52"
                                Height="52"
                                Margin="4,0"
                                Command="{Binding PlayPauseCommand}"
                                ToolTip.Tip="{i18n:T 播放/暂停}" />
                        <Button
                                Width="44"
                                Height="44"
                                Margin="3,0"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="{i18n:T 下一首}" />
                        <Button
                                Width="44"
                                Height="44"
                                Margin="3,0"
                                Command="{Binding StopCommand}"
                                ToolTip.Tip="{i18n:T 停止}" />
                    </StackPanel>
                    <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                        <Button
                                Width="48"
                                Height="40"
                                Command="{Binding CyclePlaybackModeCommand}"
                                ToolTip.Tip="{Binding PlaybackModeToolTip}" />
                        <TextBlock
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{i18n:T 输入方式}" />
                        <TextBlock
                                Width="28"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding InputModeDisplayText}" />
                        <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding UseBackgroundInput, Mode=TwoWay}" ToolTip.Tip="{Binding InputModeToolTip}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
