<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>BetterGI.Mac</AssemblyName>
		<RootNamespace>BetterGenshinImpact</RootNamespace>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>disable</ImplicitUsings>
		<RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
		<DefineConstants>$(DefineConstants);BGI_MAC</DefineConstants>
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0618;CA1416;CS1998;CS0105;CS8619;CS8620;CS8621;CS8622;CS8629;CS8631;CS8765;CS8767;CS8769;CS0168;CS0219;CS0162;CS0169;CS0414;CS0649;CS0067;CS4014;CS8605;CS8613;CS8614;CS8616;CS8617;CS8524;CS8509;CS0108;CS0659;CS0661;CS0660;CS8981;CS9113;CS9124;CS9107;NU1701;NU1608;NU1603</NoWarn>
	</PropertyGroup>

	<Import Project="MacExclude.props" />

	<!-- 直接链接编译原版的核心源码，不复制，保证与上游逻辑同步 -->
	<ItemGroup>
		<Compile Include="..\BetterGenshinImpact\**\*.cs" Exclude="..\BetterGenshinImpact\obj\**;..\BetterGenshinImpact\bin\**;@(MacExclude)" LinkBase="Shared" />
		<Compile Include="@(MacViewInclude)" LinkBase="Shared\View" />
		
	</ItemGroup>

	<!-- 识别素材、默认用户配置等运行时文件，保持与原版输出目录相同的布局 -->
	<ItemGroup>
		<None Include="..\BetterGenshinImpact\GameTask\**\Assets\**" Exclude="..\BetterGenshinImpact\GameTask\**\*.cs" Link="GameTask\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\BetterGenshinImpact\User\**" Link="User\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\BetterGenshinImpact\Resources\Images\*.png;..\BetterGenshinImpact\Resources\Images\*.jpg" Link="Resources\Images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fischless.WindowsInput\Fischless.WindowsInput.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Anthropic" Version="12.53.0" />
		<PackageReference Include="BetterGI.Assets.Map" Version="1.0.24" />
		<PackageReference Include="BetterGI.Assets.Model" Version="1.0.38" />
		<PackageReference Include="BetterGI.Assets.Other" Version="1.0.27" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="CsTrees" Version="1.0.5" />
		<PackageReference Include="CsTrees.MEAI" Version="1.0.2" />
		<PackageReference Include="DeviceId" Version="6.9.0" />
		<PackageReference Include="HungarianAlgorithm" Version="2.3.5" />
		<PackageReference Include="LibGit2Sharp" Version="0.31.0" />
		<PackageReference Include="LazyCache" Version="2.4.0" />
		<PackageReference Include="MailKit" Version="4.16.0" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.4" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.21.0" />
		<PackageReference Include="MimeKit" Version="4.16.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="OpenccNetLib" Version="1.7.0" />
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="Microsoft.ClearScript.V8" Version="7.4.5" />
		<PackageReference Include="NCalc" Version="6.2.0" />
		<PackageReference Include="Semver" Version="3.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="System.IO.Hashing" Version="9.0.4" />
		<PackageReference Include="System.IO.Packaging" Version="9.0.4" />
		<PackageReference Include="Vanara.PInvoke.CoreAudio" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.NtDll" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.SHCore" Version="4.1.3" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="4.1.3" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
		<PackageReference Include="YoloSharp" Version="6.0.3" />
	</ItemGroup>

	<!--
		原生库：
		- macOS：OpenCvSharpExtern 由 CI（.github/workflows/macos.yml）在 Apple Silicon 上从源码编译（需要 features2d / calib3d / xfeatures2d），
		  放在 native/osx-arm64/ 下；ONNX Runtime、ClearScript V8、LibGit2Sharp 的 macOS 原生库来自各自的 NuGet 包。
		- Linux：仅用于开发机上运行单元测试与冒烟测试。
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.4.5" />
		<PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="7.4.5" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.11.0.20250507" />
		<PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.4.5" />
	</ItemGroup>
	<ItemGroup>
		<None Include="native\osx-arm64\*.dylib" Condition="Exists('native\osx-arm64')" Link="runtimes\osx-arm64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
